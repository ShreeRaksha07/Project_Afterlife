# Project Afterlife - Backend Environment Variables
# Copy this file to backend/.env and populate your keys:
# cp backend/.env.example backend/.env

# Groq API Key (Required for live LLM completions via Groq)
# Obtain your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Selection (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Neon PostgreSQL Connection String (Required for project & analysis persistence)
# Obtain from your Neon project dashboard: https://console.neon.tech
DATABASE_URL=postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# GitHub Personal Access Token (Optional: increases GitHub API rate limit from 60 to 5000 req/hr)
# GITHUB_TOKEN=ghp_your_github_token_here

# Server Port & Debug
PORT=5000
FLASK_DEBUG=True
